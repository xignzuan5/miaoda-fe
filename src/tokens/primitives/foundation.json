{
  "$schema": "../../../schema/token-file.schema.json",
  "border.width.none": { "$type": "dimension", "$value": "0px", "$description": "无边框" },
  "border.width.thin": { "$type": "dimension", "$value": "1px", "$description": "默认边框宽度" },
  "border.width.strong": { "$type": "dimension", "$value": "2px", "$description": "强调和聚焦边框宽度" },
  "radius.none": { "$type": "dimension", "$value": "0px", "$description": "无圆角" },
  "radius.sm": { "$type": "dimension", "$value": "0.25rem", "$description": "小圆角" },
  "radius.md": { "$type": "dimension", "$value": "0.5rem", "$description": "默认圆角" },
  "radius.lg": { "$type": "dimension", "$value": "0.75rem", "$description": "大圆角" },
  "radius.full": { "$type": "dimension", "$value": "9999px", "$description": "胶囊和圆形圆角" },
  "shadow.sm": { "$type": "shadow", "$value": "0 1px 2px rgb(15 23 42 / 0.08)", "$description": "轻微悬浮阴影" },
  "shadow.md": { "$type": "shadow", "$value": "0 8px 24px rgb(15 23 42 / 0.14)", "$description": "下拉和浮层阴影" },
  "shadow.lg": { "$type": "shadow", "$value": "0 24px 48px rgb(15 23 42 / 0.22)", "$description": "模态容器阴影" },
  "opacity.disabled": { "$type": "number", "$value": 0.48, "$description": "禁用内容不透明度" },
  "motion.duration.fast": { "$type": "duration", "$value": "120ms", "$description": "即时反馈动效时长" },
  "motion.duration.normal": { "$type": "duration", "$value": "200ms", "$description": "默认动效时长" },
  "motion.duration.slow": { "$type": "duration", "$value": "320ms", "$description": "复杂进出场动效时长" },
  "motion.easing.standard": { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0, 1)", "$description": "默认缓动曲线" },
  "breakpoint.sm": { "$type": "dimension", "$value": "40rem", "$description": "小屏断点" },
  "breakpoint.md": { "$type": "dimension", "$value": "48rem", "$description": "中屏断点" },
  "breakpoint.lg": { "$type": "dimension", "$value": "64rem", "$description": "大屏断点" },
  "z-index.base": { "$type": "number", "$value": 0, "$description": "默认层级" },
  "z-index.dropdown": { "$type": "number", "$value": 1000, "$description": "下拉浮层层级" },
  "z-index.modal": { "$type": "number", "$value": 1100, "$description": "模态层级" },
  "z-index.toast": { "$type": "number", "$value": 1200, "$description": "全局通知层级" }
}
