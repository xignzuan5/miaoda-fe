{
  "$meta": {
    "project": "D:/obs_theme",
    "status": "draft",
    "note": "Mappings with multiple targets require property or component context."
  },
  "exact": {
    "#0f1117": ["color.background.page@dark", "color.text.inverse@dark"],
    "#161b27": ["color.surface.default@dark"],
    "#1c2333": ["color.surface.elevated@dark"],
    "#1e2438": ["color.surface.hover@dark"],
    "#1a2540": ["color.surface.selected@dark"],
    "#e8eaf0": ["color.text.primary@dark"],
    "#8b93a8": ["color.text.secondary@dark"],
    "#4d566b": ["color.text.disabled@dark", "color.status.muted@dark", "color.chart.axis@dark"],
    "#1f2535": ["color.border.subtle@dark", "color.chart.grid@dark"],
    "#2a3147": ["color.border.default@dark"],
    "#3d4663": ["color.border.strong@dark"],
    "#f4f5f7": ["color.background.page@light"],
    "#ffffff": ["color.surface.default@light", "color.text.inverse@light"],
    "#f9fafb": ["color.surface.elevated@light"],
    "#f3f4f6": ["color.surface.hover@light"],
    "#eff6ff": ["color.surface.selected@light"],
    "#111827": ["color.text.primary@light"],
    "#6b7280": ["color.text.secondary@light"],
    "#9ca3af": ["color.text.disabled@light", "color.border.strong@light", "color.status.muted@light", "color.chart.axis@light"],
    "#e5e7eb": ["color.border.subtle@light", "color.chart.grid@light"],
    "#d1d5db": ["color.border.default@light"],
    "#06b6d4": ["color.action.primary.default@dark", "color.status.info@dark", "color.chart.series.1@dark"],
    "#0891b2": ["color.action.primary.hover@dark", "color.action.primary.default@light", "color.status.info@light", "color.chart.series.1@light"],
    "#0e7490": ["color.action.primary.hover@light"],
    "#10b981": ["color.status.success", "color.chart.series.4"],
    "#f59e0b": ["color.status.warning", "color.chart.series.3"],
    "#ef4444": ["color.status.error"],
    "#8b5cf6": ["color.chart.series.2"],
    "#f97316": ["color.chart.series.5"],
    "#ec4899": ["color.chart.series.6"],
    "1px": ["border.width.default"],
    "3px": ["radius.sm"],
    "4px": ["spacing.1", "radius.md"],
    "6px": ["radius.lg"],
    "8px": ["spacing.2"],
    "12px": ["spacing.3"],
    "16px": ["spacing.4"],
    "20px": ["spacing.5"],
    "24px": ["spacing.6"],
    "32px": ["spacing.8"],
    "40px": ["spacing.10"]
  },
  "contextRules": [
    { "when": "属性是 background/backgroundColor 且值为 #06b6d4", "use": "color.action.primary.default@dark" },
    { "when": "状态是 info 且值为 #06b6d4", "use": "color.status.info@dark" },
    { "when": "ECharts 系列颜色为 #06b6d4", "use": "color.chart.series.1@dark" },
    { "when": "属性是 color 且值为 #4d566b", "use": "color.text.disabled@dark" },
    { "when": "ECharts 坐标轴使用 #4d566b", "use": "color.chart.axis@dark" },
    { "when": "4px 用作 padding 或 gap", "use": "spacing.1" },
    { "when": "4px 用作 borderRadius", "use": "radius.md" }
  ]
}
