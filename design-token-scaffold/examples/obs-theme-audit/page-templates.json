{
  "description": "obs_theme 页面模板登记；演示代码为适配版，非原项目壳层的像素级副本。",
  "sourceRoot": "D:/obs_theme",
  "shell": {
    "source": "src/layout/AppShell.tsx",
    "mount": "src/App.tsx：AuthGuard 内的 AppShell children",
    "menu": "src/layout/Sidebar.tsx",
    "breadcrumbs": "src/layout/AppShell.tsx 的 breadcrumbMap",
    "reusePolicy": "原项目直接复用；只新增内容路由和菜单项。",
    "adaptedCode": "../obs-product-mgmt/src/templates/AdminShell.tsx",
    "fixedRegions": ["顶栏", "侧栏", "全局搜索", "通知", "主题状态", "鉴权"],
    "variableRegions": ["内容插槽", "菜单与激活状态", "面包屑标签"]
  },
  "templates": [
    {
      "name": "列表页",
      "export": "ListPageTemplate",
      "source": "src/pages/users/index.tsx",
      "slots": ["title", "description", "actions", "filters", "children", "pagination"],
      "usage": "产品、用户等表格列表；透明容器，内容满宽",
      "kind": "page-content",
      "evidence": ["src/pages/users/index.tsx", "src/pages/alerts/index.tsx"]
    },
    {
      "name": "选项卡页",
      "export": "TabbedPageTemplate",
      "source": "src/pages/alerts/index.tsx",
      "slots": ["title", "actions", "tabs", "children"],
      "usage": "告警等多面板页面；选项卡行为由业务组件提供",
      "kind": "page-content",
      "evidence": ["src/pages/alerts/index.tsx", "src/pages/settings/index.tsx"]
    },
    {
      "name": "设置表单页",
      "export": "SettingsPageTemplate",
      "source": "src/pages/settings/index.tsx",
      "slots": ["title", "description", "children", "footer"],
      "usage": "设置表单，局部最大宽度 480px",
      "kind": "page-content",
      "evidence": ["src/pages/settings/index.tsx"]
    },
    {
      "name": "两列页",
      "export": "TwoColumnPageTemplate",
      "source": ["src/pages/metrics/HostDetailPage.tsx", "src/pages/incidents/IncidentDetailPage.tsx"],
      "slots": ["title", "description", "actions", "main", "aside", "mainTrack", "asideTrack"],
      "usage": "详情/监控类页面的主内容与辅助信息；轨道比例必须按来源页传入，不固定为全站比例",
      "kind": "page-layout",
      "observedLayouts": ["HostDetailPage: md=8/12 + md=4/12", "IncidentDetailPage: md=5/12 + md=7/12"],
      "responsive": "来源页 xs=12 时堆叠为单列；obs_theme 使用 MUI 默认 md=900px，若宿主主题覆写断点需同步适配层"
    },
    {
      "name": "三列卡片网格",
      "export": "ThreeColumnGridTemplate",
      "source": ["src/pages/apm/components/ServiceOverviewCards.tsx", "src/pages/integrations/index.tsx", "src/pages/settings/index.tsx"],
      "slots": ["title", "description", "actions", "children", "itemClassName"],
      "usage": "服务、集成、数据源等重复卡片；只沉淀列布局与响应式，不固化卡片业务内容",
      "kind": "content-grid",
      "observedLayouts": ["xs=12", "sm=6", "md=4（3列）"],
      "responsive": "MUI 默认断点下 <600px 单列、600-899px 两列、>=900px 三列；若宿主主题覆写断点需同步适配层"
    }
  ],
  "code": "../obs-product-mgmt/src/templates/ContentTemplates.tsx",
  "dependencies": ["React", "演示项目 index.css", "obs-theme-audit/obs-theme.css"],
  "validation": { "visual": "未验证", "scope": "类型检查与生产构建不能证明原主题完整性" }
}
