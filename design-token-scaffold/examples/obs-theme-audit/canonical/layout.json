{
  "$schema": "../../../schema/token-file.schema.json",
  "$description": "从 obs_theme 应用壳层和 Users 页面中提取的布局与页面排版 Token。",
  "$extensions": {
    "project": {
      "layer": "component",
      "status": "stable",
      "scope": ["layout", "typography"],
      "platforms": ["web"],
      "source": "D:/obs_theme/src/layout/AppShell.tsx、D:/obs_theme/src/pages/users/index.tsx"
    }
  },
  "layout.topbar.height": {
    "$type": "dimension",
    "$value": "48px",
    "$description": "应用顶栏高度为 48px。"
  },
  "layout.sidebar.width": {
    "$type": "dimension",
    "$value": "220px",
    "$description": "展开状态侧栏宽度为 220px。"
  },
  "layout.breadcrumb.height": {
    "$type": "dimension",
    "$value": "32px",
    "$description": "面包屑条高度为 32px。"
  },
  "layout.breadcrumb.padding.inline": {
    "$type": "dimension",
    "$value": "8px",
    "$description": "AppShell 面包屑条使用 MUI px:2；主题 spacing=4，因此左右内边距为 8px。"
  },
  "layout.content.padding": {
    "$type": "dimension",
    "$value": "12px",
    "$description": "Users 页面内容区使用 12px 内边距。"
  },
  "layout.page.title.font.size": {
    "$type": "dimension",
    "$value": "20px",
    "$description": "页面标题使用 h2 规格，即 20px。"
  },
  "layout.page.title.font.weight": {
    "$type": "fontWeight",
    "$value": "{font.weight.semibold}",
    "$description": "页面标题使用 600 字重。"
  },
  "layout.page.title.line.height": {
    "$type": "number",
    "$value": 1.3,
    "$description": "页面标题行高为 1.3。"
  },
  "layout.page.subtitle.font.size": {
    "$type": "dimension",
    "$value": "11px",
    "$description": "页面副标题使用 caption2 规格，即 11px。"
  },
  "layout.page.subtitle.line.height": {
    "$type": "number",
    "$value": 1.4,
    "$description": "页面副标题行高为 1.4。"
  },
  "layout.page.subtitle.color": {
    "$type": "color",
    "$value": "{color.text.secondary}",
    "$description": "页面副标题使用次要文字色。"
  },
  "overlay.scrim": {
    "$type": "color",
    "$value": "rgba(0, 0, 0, 0.55)",
    "$description": "模态框和抽屉遮罩使用 55% 黑色。"
  }
}
